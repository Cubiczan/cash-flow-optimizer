# === Xero ===
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REFRESH_TOKEN=your_xero_refresh_token_here
XERO_TENANT_ID=your_xero_tenant_id_here

# === Precoro ===
PRECORO_API_KEY=your_precoro_api_key_here

# === Microsoft Graph / Outlook ===
MS_GRAPH_CLIENT_ID=your_ms_graph_client_id_here
MS_GRAPH_CLIENT_SECRET=your_ms_graph_client_secret_here
MS_GRAPH_TENANT_ID=your_ms_graph_tenant_id_here

# === Composio ===
COMPOSIO_API_KEY=your_composio_api_key_here

# === UiPath Automation Cloud ===
UIPATH_CLIENT_ID=your_uipath_app_id_here
UIPATH_CLIENT_SECRET=your_uipath_app_secret_here
UIPATH_ORGANIZATION_NAME=your_uipath_org_name_here
UIPATH_TENANT_NAME=your_uipath_tenant_name_here
UIPATH_RELEASE_KEY=your_uipath_release_key_here
UIPATH_FOLDER_KEY=your_uipath_folder_key_here
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_SCOPE=OR.Default OR.Jobs

# === Vellum ===
VELLUM_API_KEY=your_vellum_api_key_here

# === KV Store (token persistence) ===
KV_STORE_URL=your_kv_store_url_here
KV_STORE_TOKEN=your_kv_store_token_here
